<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <defName>Bogleg_FatHediff</defName>
    <label>stored blubber</label>
    <description>This pawn has large fat stores capable of accumulating usable fat for dealing with starvation.\n\n&lt;color=#6e6e6eff&gt;Note that "nutrition" stands for a full bar of the Food need.&lt;/color&gt;</description>
    <hediffClass>Boglegs.HediffFat</hediffClass>
    <initialSeverity>1</initialSeverity>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="Boglegs.HediffCompProperties_Fat">
        <startThreshold>0.8</startThreshold>
        <conversionRate>1.1</conversionRate>
        <maxFat>2.0</maxFat>
        <starvationThreshold>0.1</starvationThreshold>
        <starvationSpeed>0.002</starvationSpeed>
        <conversionSpeed>0.002</conversionSpeed>

        <slowdownCurve>
          <points>
            <li>(0, 0)</li>
            <li>(0.5, -0.01)</li>
            <li>(1, -0.04)</li>
            <li>(1.50, -0.08)</li>
            <li>(2, -0.12)</li>
          </points>
        </slowdownCurve>

        <bluntProtectionCurve>
          <points>
            <li>(0, 0)</li>
            <li>(0.5, 0.05)</li>
            <li>(1, 0.10)</li>
            <li>(1.50, 0.15)</li>
            <li>(2.0, 0.20)</li>
          </points>
        </bluntProtectionCurve>

        <meatCurve>
          <points>
            <li>(0, 0)</li>
            <li>(0.1, 5)</li>
            <li>(0.5, 10)</li>
            <li>(1, 25)</li>
            <li>(1.50, 50)</li>
            <li>(2.0, 75)</li>
          </points>
        </meatCurve>
      </li>
    </comps>
  </HediffDef>
</Defs>
